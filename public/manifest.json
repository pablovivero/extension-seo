{
  "manifest_version": 3,
  "name": "SERP Capture",
  "version": "0.1.0",
  "description": "Captura resultados organicos visibles de Google para una lista de keywords y descarga un JSON.",
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "permissions": ["tabs", "scripting", "downloads", "storage"],
  "host_permissions": ["https://www.google.com/*", "https://www.google.es/*", "http://127.0.0.1/*"]
}
